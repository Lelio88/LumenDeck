{
  "Name": "LumenDeck",
  "Version": "0.10.0.0",
  "Author": "Lelio Buton",
  "Actions": [
    {
      "Name": "Allumer / eteindre",
      "UUID": "com.lumendeck.bulb.toggle",
      "Icon": "imgs/actions/toggle/icon",
      "Tooltip": "Bascule l'ampoule, en local, sans passer par le cloud.",
      "PropertyInspectorPath": "ui/bulb.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/toggle/key-off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "imgs/actions/toggle/key-on",
          "TitleAlignment": "bottom"
        }
      ],
      "Encoder": {
        "layout": "$A1",
        "TriggerDescription": {
          "Push": "Allumer / eteindre",
          "Rotate": ""
        }
      }
    },
    {
      "Name": "Intensite",
      "UUID": "com.lumendeck.bulb.brightness",
      "Icon": "imgs/actions/brightness/icon",
      "Tooltip": "Regle l'intensite, quel que soit le mode de l'ampoule.",
      "PropertyInspectorPath": "ui/brightness.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/brightness/key",
          "TitleAlignment": "bottom"
        }
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Push": "Allumer / eteindre",
          "Rotate": "Regler l'intensite"
        }
      }
    },
    {
      "Name": "Couleur",
      "UUID": "com.lumendeck.bulb.color",
      "Icon": "imgs/actions/color/icon",
      "Tooltip": "Applique une couleur ; la molette fait tourner la teinte.",
      "PropertyInspectorPath": "ui/color.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/color/key",
          "TitleAlignment": "bottom"
        }
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Push": "Allumer / eteindre",
          "Rotate": "Faire tourner la teinte"
        }
      }
    },
    {
      "Name": "Blanc chaud / froid",
      "UUID": "com.lumendeck.bulb.temperature",
      "Icon": "imgs/actions/temperature/icon",
      "Tooltip": "Regle la temperature de blanc, de 2700 K a 6500 K.",
      "PropertyInspectorPath": "ui/temperature.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/temperature/key",
          "TitleAlignment": "bottom"
        }
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Push": "Allumer / eteindre",
          "Rotate": "Rechauffer ou refroidir"
        }
      }
    },
    {
      "Name": "Scenario",
      "UUID": "com.lumendeck.bulb.scenario",
      "Icon": "imgs/actions/scenario/icon",
      "Tooltip": "Joue une animation lumineuse : clignotement, gyrophare, bougie, orage...",
      "PropertyInspectorPath": "ui/scenario.html",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "States": [
        {
          "Image": "imgs/actions/scenario/key",
          "TitleAlignment": "bottom"
        }
      ],
      "Encoder": {
        "layout": "$B1",
        "TriggerDescription": {
          "Push": "Lancer / arreter le scenario",
          "Rotate": ""
        }
      }
    }
  ],
  "Category": "LumenDeck",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Pilotage local d'ampoules Tuya (compatibles Calex Smart) : allumage, intensite, couleur et blanc reglable, sans cloud, en une vingtaine de millisecondes.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "UUID": "com.lumendeck.bulb"
}
